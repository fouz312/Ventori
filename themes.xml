<resources>
    <style name="Theme.Vantora" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/vantora_bg</item>
        <item name="android:statusBarColor">@color/vantora_bg</item>
        <item name="android:navigationBarColor">@color/vantora_bg</item>
    </style>
    <style name="Theme.Vantora.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vantora_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Vantora</item>
    </style>
</resources>
